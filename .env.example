# ═══════════════════════════════════════════════════════
#  K13 LOYALTY v2 — Configuration
#  Copie en .env et remplis les valeurs
# ═══════════════════════════════════════════════════════

PORT=3000
NODE_ENV=development

# Génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_MOI

# ── DISCORD ──────────────────────────────────────────────
# https://discord.com/developers/applications
# L'appli Discord doit avoir un BOT + OAuth2
DISCORD_CLIENT_ID=TON_CLIENT_ID
DISCORD_CLIENT_SECRET=TON_CLIENT_SECRET
# Pour local : http://localhost:3000/auth/discord/callback
# Pour prod  : https://loyalty.k13-esport.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Token du bot Discord (onglet Bot dans ta Discord App)
DISCORD_BOT_TOKEN=TON_BOT_TOKEN
# ID de ton serveur Discord K13 (clic droit serveur > Copier l'ID, mode dev activé)
DISCORD_GUILD_ID=TON_GUILD_ID
# ID du rôle à attribuer pour chaque palier (optionnel, boutique)
DISCORD_ROLE_BRONZE_ID=
DISCORD_ROLE_SILVER_ID=
DISCORD_ROLE_GOLD_ID=

# ── TWITCH ────────────────────────────────────────────────
# https://dev.twitch.tv/console/apps
# Redirect URIs à ajouter : http://localhost:3000/auth/twitch/callback
#                           https://loyalty.k13-esport.com/auth/twitch/callback
TWITCH_CLIENT_ID=TON_CLIENT_ID
TWITCH_CLIENT_SECRET=TON_CLIENT_SECRET
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
TWITCH_CHANNEL_LOGIN=k13esport

# ── TWITTER / X ──────────────────────────────────────────
# https://developer.twitter.com/en/portal
# IMPORTANT : X exige HTTPS même en dev → utilise ngrok pour tester
# ngrok http 3000  →  copie l'URL https et mets-la ici
# Redirect URI : https://XXXX.ngrok.io/auth/twitter/callback
TWITTER_CLIENT_ID=TON_CLIENT_ID
TWITTER_CLIENT_SECRET=TON_CLIENT_SECRET
TWITTER_REDIRECT_URI=https://TON-NGROK.ngrok.io/auth/twitter/callback
TWITTER_ACCOUNT_TO_FOLLOW=K13Esport

# ── TIKTOK ───────────────────────────────────────────────
# https://developers.tiktok.com → Login Kit
TIKTOK_CLIENT_KEY=TON_CLIENT_KEY
TIKTOK_CLIENT_SECRET=TON_CLIENT_SECRET
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# ── ADMIN ─────────────────────────────────────────────────
ADMIN_PASSWORD=k13admin2025

# ── BOUTIQUE (optionnel Shopify) ──────────────────────────
SHOPIFY_STORE=ton-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# ── STRIPE ────────────────────────────────────────────────────────────────────
# Clé secrète Stripe (Dashboard → Développeurs → Clés API)
# Utilise sk_test_... pour les tests, sk_live_... pour la prod
STRIPE_SECRET_KEY=sk_test_...

# IDs des coupons créés dans Stripe (Dashboard → Produits → Coupons)
# Crée 3 coupons : -5%, -10%, -20% (durée = once, pas de date limite sur le coupon lui-même)
# Puis copie leurs IDs ici :
STRIPE_COUPON_5=K13_5PCT
STRIPE_COUPON_10=K13_10PCT
STRIPE_COUPON_20=K13_20PCT
# ── STREAMELEMENTS ────────────────────────────────────────────────────────────
# Pour tracker le watchtime automatiquement sans que l'utilisateur clique sur "Tracker"
#
# 1. Va sur streamelements.com → connecte-toi avec Twitch
# 2. Active le Loyalty System : Dashboard → Loyalty → Enable
# 3. Récupère ton JWT Token :
#    Dashboard → clique sur ton avatar (haut droite) → "Show Secrets" → copie "JWT Token"
# 4. Récupère ton Channel ID :
#    Va sur https://api.streamelements.com/kappa/v2/channels/me avec ton JWT
#    OU regarde l'URL de ton dashboard : streamelements.com/dashboard → l'ID est dans les settings
#    OU tape cette commande : curl -H "Authorization: Bearer TON_JWT" https://api.streamelements.com/kappa/v2/channels/me
STREAMELEMENTS_JWT=TON_JWT_TOKEN_ICI
STREAMELEMENTS_CHANNEL_ID=TON_CHANNEL_ID_ICI
